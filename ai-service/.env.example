# ── ai-service/.env.example ───────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Must match INTERNAL_SERVICE_KEY in server/.env exactly.
# ai-service refuses to start if this is empty.
INTERNAL_SERVICE_KEY=change-me-to-a-random-secret

# LLM provider: "gemini" for real runs, "mock" for tests / offline dev.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=gemini.
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Verify the current model id at https://ai.google.dev/gemini-api/docs/models/gemini
GEMINI_MODEL=gemini-1.5-flash-latest

# LLM generation settings.
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_S=45
LLM_MAX_RPM=10

# Embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB persistent storage path (relative to ai-service/).
CHROMA_PATH=./chroma_data

# Logging level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
