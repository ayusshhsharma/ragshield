# ── server/.env.example ───────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Option A — MongoDB Atlas (recommended for cloud dev):
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/ragshield
# Option B — local MongoDB install:
#   MONGO_URI=mongodb://localhost:27017/ragshield
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/ragshield

# JWT — must be at least 32 characters; server refuses to start if shorter.
JWT_SECRET=change-me-to-a-random-32-plus-char-string
JWT_EXPIRES_IN=7d

# CORS — set to the exact origin the browser sends (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# Internal AI service (FastAPI).
AI_SERVICE_URL=http://localhost:8000
# Must match INTERNAL_SERVICE_KEY in ai-service/.env exactly.
INTERNAL_SERVICE_KEY=change-me-to-a-random-secret

# Runner tuning.
RUN_CONCURRENCY=2
DEFAULT_REPEATS=3

# File upload.
MAX_UPLOAD_MB=5

# Rate limiting.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
